        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "This one wasn\u2019t particularly big, maybe twice as tall as a man,
          but it thought that that bug boil smelled delicious. Keeping to the shadows,
          it crept closer and closer."
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0

        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "See, they get these creatures down there\u2013 rougarou\u2013  bigger
          than dogs, and ten times as fierce because. Well, so I hear, they used
          to be people themselves. "
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 1
      isRoot: 0
      isGroup: 0
